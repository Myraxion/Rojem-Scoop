{
    "version": "1.1.86",
    "description": "A beautiful, feature-rich SSH workspace built with Electron, React, and xterm.js.",
    "homepage": "https://netcatty.app/",
    "license": "GPL-3.0-only",
    "notes": "已保存的密码和私钥受当前 Windows 用户保护；将数据目录迁移到其他电脑或 Windows 用户后，需要重新输入这些敏感信息。",
    "architecture": {
        "64bit": {
            "url": "https://github.com/binaricat/Netcatty/releases/download/v1.1.86/Netcatty-1.1.86-win-x64.exe#/dl.7z",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "if (!(Test-Path \"$persist_dir\\data\")) { New-Item \"$persist_dir\\data\" -ItemType Directory -Force | Out-Null }"
            ],
            "hash": "37b0d59d88e39a61ed813f6334451f9b69ab825e1db475929d74c0d719c81a9f"
        }
    },
    "shortcuts": [
        [
            "Netcatty.exe",
            "Netcatty"
        ]
    ],
    "post_install": "Remove-Item \"$dir\\uninstall*\", \"$dir\\`$*\", \"$dir\\resources\\app-update.yml\" -Force -Recurse -ErrorAction SilentlyContinue",
    "post_uninstall": "if ($purge) { Remove-Item \"$env:APPDATA\\netcatty\" -Force -Recurse -ErrorAction SilentlyContinue }",
    "persist": "data",
    "checkver": {
        "github": "https://github.com/binaricat/Netcatty"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/binaricat/Netcatty/releases/download/v$version/Netcatty-$version-win-x64.exe#/dl.7z"
            }
        }
    }
}
