        "arm64": {
            "url": "https://raw.githubusercontent.com/nyam1003/imagine/7eb0b85dfad2ae70c8e7bec709457beec0db528d/arm64/Imagine_2.7.1_arm64_Unicode_Full.zip",
            "hash": "c7fdeac2f5a889b2d99d61f23a3e87b229d803c0bf5b4650119bea71e4d15181",
            "bin": [
