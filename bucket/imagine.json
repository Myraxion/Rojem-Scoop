        },
        "32bit": {
            "url": "https://raw.githubusercontent.com/nyam1003/imagine/55ca4c32f9b27c601556c4748e02450618573b7a/Imagine_2.7.1_Unicode_Full.zip",
            "hash": "8131458596d9be1ab3606054c8152fb97da3d58a0c0e672168c96afb9b1f60a2",
            "bin": "Imagine.exe",
