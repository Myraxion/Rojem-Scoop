    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\Imagine.ini\")) { New-Item \"$persist_dir\\Imagine.ini\" -Force | Out-Null }",
        "",
        "$tc_procs = Get-Process -Name \"totalcmd\", \"totalcmd64\" -ErrorAction SilentlyContinue",
        "if ($tc_procs) {",
        "    Write-Host \"[Error] Total Commander is currently running!\" -ForegroundColor Red",
        "    Write-Host \"Installation aborted to protect directory structure. Please close Total Commander and try again.\" -ForegroundColor Yellow",
        "    exit 1",
        "}"
    ],
    "installer": {
        "script": [
            "$TCDir = $(appdir totalcommander $global)",
            "",
            "if ($TCDir -and (Test-Path \"$TCDir\\current\")) {",
            "    Write-Host \"Found Total Commander, integrating plugin...\" -ForegroundColor Cyan",
            "    ",
            "    $PluginDir = \"$TCDir\\current\\plugins\\Wlx\\Imagine\"",
            "    if (!(Test-Path \"$PluginDir\")) { New-Item \"$PluginDir\" -ItemType Directory -Force | Out-Null }",
            "    ",
            "    Copy-Item \"$dir\\*\" \"$PluginDir\" -Recurse -Force -Exclude \"Imagine.ini\", \"PlugInst.inf\"",
            "    Write-Host \"Imagine plugin installed to: $PluginDir\" -ForegroundColor Green",
            "} else {",
            "    Write-Host \"Total Commander (Scoop) not found. Installing as standalone application only.\" -ForegroundColor Yellow",
            "}"
        ]
    },
    "persist": [
        "Imagine.ini",
        "PlugInst.inf",
        "Plugin"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/nyam1003/imagine/git/trees/main",
        "regex": "\"sha\":\\s*\"(?<sha>[0-9a-f]{7})(?<longsha>[0-9a-f]{33})\"[\\s\\S]*?\"path\":\\s*\"Imagine_(?<version>[\\d.]+)_Unicode_Full\\.zip\"",
        "replace": "${version}-${sha}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://raw.githubusercontent.com/nyam1003/imagine/$matchSha$matchLongsha/x64/Imagine_$matchVersion_x64_Unicode_Full.zip"
            },
            "32bit": {
                "url": "https://raw.githubusercontent.com/nyam1003/imagine/$matchSha$matchLongsha/Imagine_$matchVersion_Unicode_Full.zip"
            },
            "arm64": {
                "url": "https://raw.githubusercontent.com/nyam1003/imagine/$matchSha$matchLongsha/arm64/Imagine_$matchVersion_arm64_Unicode_Full.zip"
            }
        }
    }
}
