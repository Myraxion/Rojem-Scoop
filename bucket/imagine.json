        "32bit": {
            "url": "https://raw.githubusercontent.com/nyam1003/imagine/7eb0b85dfad2ae70c8e7bec709457beec0db528d/Imagine_2.7.1_Unicode_Full.zip",
            "hash": "2c42cc7069f937df2d32f357f5d6afad9fcbb3ce1503080c35bfc80bd5e7cf98",
            "bin": "Imagine.exe",
